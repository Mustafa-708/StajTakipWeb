@model OgrenciPanelModel
@{ ViewData["Title"] = "Öğrenci Paneli"; var bekleyenOdevVar = Model.Odevler.Any(x => x.TeslimTarihi == null); }
<div class="student-hero">
<div><span class="eyebrow">STAJ TAKİP SİSTEMİ</span><h1>Merhaba, @Model.Ogrenci.Ad 👋</h1><p>Staj yolculuğunu buradan takip et, çalışmalarını kaydet.</p></div>
<span class="student-chip">@Model.Ogrenci.Numara · @Model.Ogrenci.Bolum</span>
</div>
@if (Model.OkunmamisDuyuruSayisi > 0 || bekleyenOdevVar) {
<section class="notification-center" aria-label="Yeni bildirimler">
<div class="notification-center-heading"><span class="notification-live-dot"></span><strong>Yeni işlerin var</strong><small>Panelini kontrol etmeyi unutma.</small></div>
<div class="notification-center-actions">
@if (bekleyenOdevVar) { <a asp-controller="OgrenciPanel" asp-action="Odevler" class="notification-center-link"><span>📋</span><span><strong>@Model.Odevler.Count(x => x.TeslimTarihi == null) teslim bekleyen ödev</strong><small>Ödevlerini görüntüle ve teslim et →</small></span></a> }
@if (Model.OkunmamisDuyuruSayisi > 0) { <a asp-controller="OgrenciPanel" asp-action="Duyurular" class="notification-center-link"><span>📣</span><span><strong>@Model.OkunmamisDuyuruSayisi okunmamış duyuru</strong><small>Son duyuruları oku →</small></span></a> }
</div>
</section>
}
<div class="row g-3 mb-4">
<div class="col-12"><div class="d-flex flex-wrap gap-2"><a asp-controller="OgrenciPanel" asp-action="Duyurular" class="btn btn-outline-primary @(Model.OkunmamisDuyuruSayisi > 0 ? "notification-pulse" : "")" aria-label="Duyurular, @Model.OkunmamisDuyuruSayisi okunmamış">Duyurular <span class="badge bg-primary ms-1">@Model.OkunmamisDuyuruSayisi yeni</span></a><a asp-controller="OgrenciPanel" asp-action="Takvim" class="btn btn-outline-secondary">Teslim takvimim →</a></div></div>
<div class="col-6 col-lg-3"><div class="metric"><span>Firma</span><strong class="metric-text">@(Model.Staj?.FirmaAdi ?? "Henüz eklenmedi")</strong></div></div>
<div class="col-6 col-lg-3"><div class="metric"><span>Toplam rapor</span><strong>@Model.Raporlar.Count</strong></div></div>
<div class="col-6 col-lg-3"><div class="metric"><span>Onay bekleyen</span><strong>@Model.Raporlar.Count(x => x.Durum == "Onay bekliyor")</strong></div></div>
<div class="col-6 col-lg-3"><div class="metric"><span>Onaylanan rapor</span><strong>@Model.Raporlar.Count(x => x.Durum == "Onaylandı")</strong></div></div>
</div>
<partial name="_OgrenciOzet" model="Model" />
<div class="row g-4">
<div class="col-12"><a class="feature-card @(bekleyenOdevVar ? "notification-pulse notification-pulse-task" : "")" asp-controller="OgrenciPanel" asp-action="Odevler"><h2>📋 Ödevlerim @if (bekleyenOdevVar) { <span class="notification-dot" title="Teslim bekleyen ödev var" aria-label="Teslim bekleyen ödev var"></span> }</h2><p>Yöneticinin atadığı görevleri görüntüle, çalışmalarını teslim et ve geri bildirimlerini takip et.</p><span class="feature-link">Ödevlerime git →</span></a></div>
@foreach (var item in new[] {
new { Icon = "👤", Title = "Kişisel Bilgilerim", Text = "Öğrenci bilgilerini görüntüle, telefon numaranı güncelle.", Action = "Profil", Link = "Profilimi görüntüle" },
new { Icon = "🏢", Title = "Staj Bilgilerim", Text = "Firmanı, işyeri sorumlunu ve staj tarihlerini kaydet.", Action = "Staj", Link = "Staj bilgilerimi düzenle" },
new { Icon = "📖", Title = "Staj Defterim", Text = "Günlük çalışmalarını yaz, taslaklarını tamamla ve onaya gönder.", Action = "Defter", Link = "Staj defterimi aç" },
new { Icon = "✅", Title = "Değerlendirmelerim", Text = "Raporlarının durumunu ve sorumlu geri bildirimlerini takip et.", Action = "Degerlendirmeler", Link = "Değerlendirmeleri görüntüle" }
}) {
<div class="col-md-6"><a class="feature-card" asp-controller="OgrenciPanel" asp-action="@item.Action"><span class="feature-icon">@item.Icon</span><h2>@item.Title</h2><p>@item.Text</p><span class="feature-link">@item.Link <span aria-hidden="true">→</span></span></a></div>
}
</div>
<section class="surface mt-4"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Son çalışmalarım</h2><a asp-controller="OgrenciPanel" asp-action="Rapor" class="btn btn-primary btn-sm">+ Yeni rapor</a></div>
@if (!Model.Raporlar.Any()) { <p class="text-muted mb-0">Henüz rapor eklemedin. Önce staj bilgilerini tamamla, ardından ilk gününü kaydet.</p> }
else { foreach (var rapor in Model.Raporlar.Take(3)) { <div class="report-row"><div><a asp-controller="OgrenciPanel" asp-action="Rapor" asp-route-id="@rapor.Id">@rapor.Baslik</a><small>@rapor.Tarih?.ToString("dd.MM.yyyy")</small></div><span class="status">@rapor.Durum</span></div> } }
</section>

