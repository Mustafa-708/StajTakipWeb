@model TeslimForm
@{ ViewData["Title"] = "Ödev Detayı"; var odev = Model.Odev!; }
<partial name="_Nav" />
<div class="page-heading"><span class="eyebrow">ÖDEV DETAYI</span><h1>@odev.Baslik</h1><p>Son teslim: @odev.SonTeslim.ToString("dd.MM.yyyy") · @odev.Durum</p></div>
<section class="surface mb-4"><h2 class="h5">Görev açıklaması</h2><div class="report-content">@odev.Aciklama</div></section>
<section class="surface"><h2 class="h5">Çalışmam</h2>
@if (odev.TeslimTarihi.HasValue) { <p class="text-muted small">@odev.TeslimTarihi.Value.ToString("dd.MM.yyyy HH:mm") tarihinde teslim edildi.</p><div class="report-content">@odev.TeslimMetni</div>@if (!string.IsNullOrWhiteSpace(odev.TeslimBaglantisi)) { <a href="@odev.TeslimBaglantisi" target="_blank" rel="noopener noreferrer" class="d-block mt-2">Çalışma bağlantısı ↗</a> }<hr /><h3 class="h6">Yönetici değerlendirmesi</h3>@if (odev.Not.HasValue) { <p><strong>@odev.Not / 100</strong></p><div class="report-content">@odev.GeriBildirim</div> } else { <p class="text-muted">Çalışman değerlendirme bekliyor.</p> } }
else if (odev.SonTeslim.Date < DateTime.Today) { <p class="text-muted">Bu ödevin teslim süresi doldu.</p> }
else { var kalanGun = (odev.SonTeslim.Date - DateTime.Today).Days; @if (kalanGun <= 3) { <div class="alert alert-warning"><strong>Son teslim tarihi yaklaşıyor:</strong> @kalanGun gün kaldı.</div> } <form method="post" asp-route-id="@odev.Id"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="TeslimMetni" class="form-label mt-3"></label><textarea asp-for="TeslimMetni" class="form-control" rows="8" placeholder="Yaptığın çalışmayı ve sonuçlarını anlat."></textarea><label asp-for="TeslimBaglantisi" class="form-label mt-3"></label><input asp-for="TeslimBaglantisi" class="form-control" placeholder="https://…" /><p class="text-muted small mt-3">Gönderildikten sonra teslimin değiştirilemez.</p><button type="submit" class="btn btn-primary">Ödevi teslim et</button></form> }
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
