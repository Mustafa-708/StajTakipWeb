@model List<Odev>
@{ ViewData["Title"] = "Ödevlerim"; }
<partial name="_Nav" />
<div class="page-heading"><span class="eyebrow">GÖREVLERİM</span><h1>Ödevlerim</h1><p>Yöneticinin atadığı görevleri takip et, çalışmalarını teslim et.</p></div>
<partial name="_OdevFiltreleri" />
@if (!Model.Any()) { <section class="surface empty-state"><h2 class="h5">Gösterilecek ödev bulunamadı</h2><p class="mb-0">Bu filtreye uygun ödev yok. Tümünü görmek için filtreleri temizleyebilirsin.</p></section> }
else { <div class="row g-4">@foreach(var item in Model) { <div class="col-md-6"><a class="feature-card" asp-action="Odev" asp-route-id="@item.Id"><span class="status mb-3">@item.Durum</span><h2>@item.Baslik</h2><p>Son teslim: @item.SonTeslim.ToString("dd.MM.yyyy")</p>@if (item.Not.HasValue) { <p>Notun: <strong>@item.Not / 100</strong></p> }<span class="feature-link">Ödevi görüntüle →</span></a></div> }</div> }

