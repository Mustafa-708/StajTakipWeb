@model List<DuyuruSatiri>
@{ ViewData["Title"] = "Duyurular"; }
<partial name="_Nav" />
<div class="page-heading"><span class="eyebrow">DUYURU PANOSU</span><h1>Duyurular</h1><p>Yönetimden gelen bilgilendirmeler ve staj hatırlatmaları.</p></div>
@if (!Model.Any()) { <section class="surface empty-state"><h2 class="h5">Şu an yayında duyuru yok</h2><p class="mb-0">Yeni bir duyuru yayımlandığında burada görebilirsin.</p></section> }
@foreach(var row in Model) { <article class="surface mb-3 @(row.Okundu ? "" : "notification-pulse notification-pulse-item")"><div class="d-flex justify-content-between gap-3"><h2 class="h5">@row.Duyuru.Baslik</h2><span class="status">@(row.Okundu ? "Okundu" : "Yeni")</span></div><small class="text-muted">@row.Duyuru.YayinTarihi.ToString("dd.MM.yyyy HH:mm")</small><div class="report-content">@row.Duyuru.Icerik</div>@if (!row.Okundu) { <form method="post" asp-action="DuyuruOku" asp-route-id="@row.Duyuru.Id" class="mt-3"><button type="submit" class="btn btn-outline-primary btn-sm">Okudum</button></form> }</article> }
